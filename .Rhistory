cat(sprintf("  MAPE: %.2f%%\n\n", mape_ensemble))
# Comparar con mejor individual
mejora_ensemble <- ((best_result$mae - mae_ensemble) / best_result$mae) * 100
if (mae_ensemble < best_result$mae) {
cat(sprintf("✅ Ensemble MEJOR que mejor individual: %.2f%% mejora\n\n", mejora_ensemble))
use_ensemble <- TRUE
final_mae <- mae_ensemble
final_r2 <- r2_ensemble
final_name <- "Ensemble (Top 3)"
} else {
cat(sprintf("○ Mejor individual supera ensemble por %.2f%%\n", -mejora_ensemble))
cat("   Usaremos el mejor modelo individual\n\n")
use_ensemble <- FALSE
