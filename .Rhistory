cat("10. NORMALIZANDO DATOS\n")
cat("--------------------------------------------------------------------\n")
# Versión A
preprocess_A <- preProcess(
train_A %>% select(all_of(all_numeric_features)),
method = c("center", "scale")
)
train_A_scaled_features <- predict(preprocess_A,
train_A %>% select(all_of(all_numeric_features)))
val_A_scaled_features <- predict(preprocess_A,
val_A %>% select(all_of(all_numeric_features)))
test_A_scaled_features <- predict(preprocess_A,
test_A %>% select(all_of(all_numeric_features)))
train_A_scaled <- bind_cols(
train_A %>% select(property_id, log_price),
train_A_scaled_features
)
val_A_scaled <- bind_cols(
val_A %>% select(property_id, log_price),
val_A_scaled_features
)
test_A_scaled <- bind_cols(
test_A %>% select(property_id),
test_A_scaled_features
)
# Versión B (normalizar solo numéricas, no one-hot)
preprocess_B <- preProcess(
train_B %>% select(all_of(all_numeric_features)),
method = c("center", "scale")
)
train_B_scaled_numeric <- predict(preprocess_B,
train_B %>% select(all_of(all_numeric_features)))
val_B_scaled_numeric <- predict(preprocess_B,
val_B %>% select(all_of(all_numeric_features)))
test_B_scaled_numeric <- predict(preprocess_B,
test_B %>% select(all_of(all_numeric_features)))
train_B_scaled <- bind_cols(
train_B %>% select(property_id, log_price),
train_B_scaled_numeric,
train_B %>% select(all_of(onehot_features))
)
val_B_scaled <- bind_cols(
val_B %>% select(property_id, log_price),
val_B_scaled_numeric,
val_B %>% select(all_of(onehot_features))
)
test_B_scaled <- bind_cols(
test_B %>% select(property_id),
test_B_scaled_numeric,
test_B %>% select(all_of(onehot_features))
)
