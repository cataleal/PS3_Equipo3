html <- paste0("<b>Precio:</b> ",
scales::dollar(db$price),
"<br> <b>Area:</b> ",
as.integer(db$surface_total), " mt2",
"<br> <b>Tipo de immueble:</b> ",
db$property_type,
"<br> <b>Numero de alcobas:</b> ",
as.integer(db$rooms),
"<br> <b>Numero de baños:</b> ",
as.integer(db$bathrooms),
"<br> <b>Sector:</b> ",
db$l4,
"<br> <b>Barrio:</b> ",
db$l5)
